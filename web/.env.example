# ============================================================
# Portfolio ML System — Web Frontend (Phase A.2)
# ============================================================

# Client-side / browser-exposed FastAPI base (used when NOT proxying).
# The default app uses Next.js rewrites to proxy /api/* → INTERNAL_API_URL,
# so NEXT_PUBLIC_API_URL is currently unused but reserved for future direct
# calls (e.g., from a client component if we ever opt out of the proxy).
NEXT_PUBLIC_API_URL=http://localhost:8070

# Server-side rewrite destination. Next.js forwards /api/* here.
# - Local dev:  http://localhost:8070  (FastAPI on host)
# - Docker:     http://ml-api:8000     (FastAPI inside compose network)
INTERNAL_API_URL=http://localhost:8070
