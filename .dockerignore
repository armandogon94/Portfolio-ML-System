# Version control
.git
.gitignore

# Python artifacts
__pycache__
*.pyc
*.pyo
*.egg-info
.pytest_cache
.ruff_cache

# Virtual environments
.venv
venv

# IDE
.vscode
.idea
*.swp

# Generated data (regenerated inside container if needed)
data/raw/
data/processed/

# Experiment tracking
wandb/
mlruns/

# Environment secrets
.env

# Documentation (not needed in the container)
*.md
!README.md
docs/
reports/

# Agent artifacts
.claude/
.handoff/

# Checkpoints are NOT baked into the image — they arrive at runtime through the
# read-only bind mount in infra/compose/base.yml. Excluding them here keeps the
# build context small and stops a stale local model from being frozen into an
# image that then disagrees with what MLflow has on record.
checkpoints/

# Next.js / web frontend build artifacts (A.2.10)
web/node_modules/
web/.next/
web/out/
web/coverage/
web/.turbo/

# OS files
.DS_Store
Thumbs.db
