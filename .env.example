# =============================================================================
# Copy to .env:  cp .env.example .env
# Every value here is a safe local default. Nothing secret belongs in this file.
# =============================================================================

# ── Ports ────────────────────────────────────────────────────────────────────
# Host-side only. Inside the containers the services bind framework defaults
# (8000, 3070) — container network namespaces are isolated, so collisions there
# are impossible and only the host side needs allocating.
#
# NEVER set these to 3000, 8000, 5000, 7000, 5432, 6379 or 11434:
# 5000/7000 are macOS AirPlay Receiver, 11434 is Ollama, and the rest are
# framework defaults that collide with any other project on the machine.
# scripts/serve.py refuses to start on any of them. See docs/ports.example.md.

WEB_PORT=3070
BACKEND_PORT=8070
MLFLOW_TRACKING_PORT=5070

# ── MLflow ───────────────────────────────────────────────────────────────────
# Without Docker, leave this pointing at the local server or unset it entirely
# to fall back to a file store in ./mlruns. Inside Docker, compose overrides it
# to http://mlflow:5000 (the container-internal port).
MLFLOW_TRACKING_URI=http://localhost:5070

# ── Weights & Biases (optional) ──────────────────────────────────────────────
# MLflow is the primary tracker and needs no account — see
# docs/adr/0002-experiment-tracking.md. W&B is off unless you replace the
# placeholder below; BaseTrainer treats this exact string as "unset", so
# copying this file verbatim will not produce an auth error.
WANDB_API_KEY=your_key_here
# WANDB_MODE=offline

# ── Kaggle credentials (required to download any real dataset) ───────────────
# Either set these two variables, or drop kaggle.json at ~/.kaggle/kaggle.json.
# Get a token at https://www.kaggle.com/settings/account -> "Create New Token".
#
# IEEE-CIS ALSO needs a one-click acceptance of the competition rules, which
# cannot be scripted:
#   https://www.kaggle.com/competitions/ieee-fraud-detection/rules
#
# No credentials at all? scripts/download_data.py --dataset ulb-creditcard
# fetches a real fraud dataset from OpenML with no account. See data/README.md.
#
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# Downloads are cached to ~/.cache/kagglehub/ — outside this repo and outside
# the Docker build context, so data/raw/ stays small and nothing large is ever
# committed.

# ── Runtime ──────────────────────────────────────────────────────────────────
# Falls back to CPU for ops with no MPS kernel instead of hard-erroring.
PYTORCH_ENABLE_MPS_FALLBACK=1

LOG_LEVEL=INFO
LOG_FORMAT=text          # 'json' for structured logs; compose sets json for the API
DEBUG=false
