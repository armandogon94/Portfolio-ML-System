# ============================================================
# PORT CONFIGURATION (Project 07 — ML System Portfolio)
# ============================================================
# Host ports follow global convention: 30{NN} for frontend, 80{NN} for backend
# See docs/ports.example.md for the convention

# Next.js demo UI (ml-web)
WEB_PORT=3070

# Backend API (FastAPI)
BACKEND_PORT=8070

# MLflow Tracking UI
MLFLOW_TRACKING_PORT=5070

# ============================================================
# MLFLOW CONFIGURATION
# ============================================================
# Local development (no Docker): file-based tracking in ./mlruns
# MLFLOW_TRACKING_URI=mlruns
#
# With Docker: containers use http://mlflow:5000 (set in docker-compose.yml)
# Host browser accesses MLflow UI at http://localhost:5070
MLFLOW_TRACKING_URI=http://localhost:5070

# ============================================================
# EXPERIMENT TRACKING
# ============================================================
# Weights & Biases API key (optional — get free key at https://wandb.ai)
# Leave as-is for local-only logging; MLflow always tracks locally.
WANDB_API_KEY=your_key_here

# Set to "offline" to log locally without internet
# WANDB_MODE=offline

# ============================================================
# STREAMING DATASETS (Phase A.1)
# ============================================================
# Kaggle API credentials — required for `--modality stream` or `mixed` on
# any model whose config declares `data.kaggle_slug`. Two options:
#   (1) set the env vars below, OR
#   (2) drop kaggle.json at ~/.kaggle/kaggle.json (standard Kaggle location)
# Generate a key at https://www.kaggle.com/settings/account → "Create New Token".
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# Hugging Face token — required only for gated/private HF datasets streamed
# via hf_stream(). Public datasets do not need this.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxx

# Streamed datasets are cached to ~/.cache/kagglehub/ (outside this repo)
# so `data/raw/` stays small even when training on real data.

# ============================================================
# DEVELOPMENT & DEBUG
# ============================================================
# PyTorch MPS fallback for unsupported operations
PYTORCH_ENABLE_MPS_FALLBACK=1

# Log level for API server
LOG_LEVEL=INFO

# Debug mode
DEBUG=false
